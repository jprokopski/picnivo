  "components": {
    "schemas": {
      "AddItemRequest": {
        "required": [
          "participantId",
          "label"
        ],
        "type": "object",
        "properties": {
          "participantId": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "AddItemResponse": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AttendanceStatus": {
        "type": "integer"
      },
      "CastVotesRequest": {
        "required": [
          "votes"
        ],
        "type": "object",
        "properties": {
          "votes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VoteDto"
            }
          }
        }
      },
      "CreateEventRequest": {
        "required": [
          "title",
          "description",
          "location",
          "dateOptions",
          "items"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "location": {
            "type": [
              "null",
              "string"
            ]
          },
          "dateOptions": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateEventResponse": {
        "required": [
          "id",
          "token",
          "participantId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string"
          },
          "participantId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DateOptionDto": {
        "required": [
          "id",
          "startsAt",
          "yesCount",
          "maybeCount",
          "noCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "yesCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "maybeCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "noCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "EventDetailResponse": {
        "required": [
          "title",
          "description",
          "location",
          "organizerId",
          "organizerName",
          "bestDateOptionId",
          "chosenDateOptionId",
          "dateOptions",
          "items",
          "participants",
          "you"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "location": {
            "type": [
              "null",
              "string"
            ]
          },
          "organizerId": {
            "type": "string",
            "format": "uuid"
          },
          "organizerName": {
            "type": "string"
          },
          "bestDateOptionId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "chosenDateOptionId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "dateOptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DateOptionDto"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventItemDto"
            }
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParticipantDto"
            }
          },
          "you": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/YouDto"
              }
            ]
          }
        }
      },
      "EventItemDto": {
        "required": [
          "id",
          "label",
          "claimedByParticipantId",
          "claimedByName",
          "addedByParticipantId",
          "orphanedFromName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          },
          "claimedByParticipantId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "claimedByName": {
            "type": [
              "null",
              "string"
            ]
          },
          "addedByParticipantId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "orphanedFromName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EventSummaryResponse": {
        "required": [
          "id",
          "title",
          "location",
          "token",
          "createdAt",
          "dateOptionCount",
          "itemCount",
          "soonestDate",
          "participantCount",
          "participantNames",
          "claimedCount",
          "chosenDateOptionId",
          "chosenDateStartsAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": [
              "null",
              "string"
            ]
          },
          "token": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "dateOptionCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "itemCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "soonestDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "participantCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "participantNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claimedCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "chosenDateOptionId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "chosenDateStartsAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "JoinEventRequest": {
        "required": [
          "displayName"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          }
        }
      },
      "JoinEventResponse": {
        "required": [
          "participantId",
          "duplicateName"
        ],
        "type": "object",
        "properties": {
          "participantId": {
            "type": "string",
            "format": "uuid"
          },
          "duplicateName": {
            "type": "boolean"
          }
        }
      },
      "ParticipantDto": {
        "required": [
          "id",
          "displayName",
          "isOrganizer",
          "attendance",
          "votes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "isOrganizer": {
            "type": "boolean"
          },
          "attendance": {
            "$ref": "#/components/schemas/AttendanceStatus"
          },
          "votes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParticipantVoteDto"
            }
          }
        }
      },
      "ParticipantVoteDto": {
        "required": [
          "dateOptionId",
          "choice"
        ],
        "type": "object",
        "properties": {
          "dateOptionId": {
            "type": "string",
            "format": "uuid"
          },
          "choice": {
            "$ref": "#/components/schemas/VoteChoice"
          }
        }
      },
      "SelectFinalDateRequest": {
        "required": [
          "dateOptionId"
        ],
        "type": "object",
        "properties": {
          "dateOptionId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "SetAttendanceRequest": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AttendanceStatus"
          }
        }
      },
      "VoteChoice": {
        "type": "integer"
      },
      "VoteDto": {
        "required": [
          "dateOptionId",
          "choice"
        ],
        "type": "object",
        "properties": {
          "dateOptionId": {
            "type": "string",
            "format": "uuid"
          },
          "choice": {
            "$ref": "#/components/schemas/VoteChoice"
          }
        }
      },
      "YouDto": {
        "required": [
          "votes",
          "claimedItemIds",
          "attendance"
        ],
        "type": "object",
        "properties": {
          "votes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/YouVoteDto"
            }
          },
          "claimedItemIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "attendance": {
            "$ref": "#/components/schemas/AttendanceStatus"
          }
        }
      },
      "YouVoteDto": {
        "required": [
          "dateOptionId",
          "choice"
        ],
        "type": "object",
        "properties": {
          "dateOptionId": {
            "type": "string",
            "format": "uuid"
          },
          "choice": {
            "$ref": "#/components/schemas/VoteChoice"
          }
        }
      }
    }
