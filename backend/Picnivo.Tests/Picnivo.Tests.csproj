<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <_PicnivoApiSpec>$(MSBuildProjectDirectory)/../Picnivo.API/Picnivo.API.json</_PicnivoApiSpec>
    <_GeneratedClient>$(MSBuildProjectDirectory)/Client/PicnivoApiClient.cs</_GeneratedClient>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude generated directory from SDK glob so we control inclusion via the target -->
    <Compile Remove="Client/**" />
  </ItemGroup>

  <Target Name="GenerateApiClient"
          BeforeTargets="CoreCompile"
          Condition="Exists('$(_PicnivoApiSpec)')">
    <MakeDir Directories="$(MSBuildProjectDirectory)/Client" />
    <Exec Command="dotnet nswag run nswag.json"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Compile Include="$(_GeneratedClient)" />
    </ItemGroup>
  </Target>

  <!-- On incremental builds the spec is unchanged, so also include the already-generated file -->
  <Target Name="IncludeGeneratedClient"
          BeforeTargets="CoreCompile"
          Condition="!Exists('$(_PicnivoApiSpec)') And Exists('$(_GeneratedClient)')">
    <ItemGroup>
      <Compile Include="$(_GeneratedClient)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.*" />
    <PackageReference Include="Shouldly" Version="4.*" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Picnivo.API\Picnivo.API.csproj" />
  </ItemGroup>

</Project>
