{
  "name": "picnivo",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "extract": "lingui extract --clean",
    "compile": "lingui compile --typescript",
    "i18n:sync": "lingui extract --clean && lingui compile --typescript && git add src/locales",
    "format:check": "prettier --check src/",
    "preview:cf": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler deploy --env preview",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "cf:tail": "wrangler tail",
    "cf:tail:preview": "wrangler tail --env preview",
    "orval": "orval",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@lingui/core": "^6.2.0",
    "@lingui/macro": "^5.9.5",
    "@lingui/react": "^6.2.0",
    "@lingui/swc-plugin": "^6.3.0",
    "@lingui/vite-plugin": "^6.2.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.545.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.1",
    "@cloudflare/workers-types": "^4.20260601.1",
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "^6.2.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-tailwindcss": "4.0.0-alpha.7",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^28.1.0",
    "lint-staged": "^17.0.8",
    "orval": "^7.10.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.97.0"
  }
}
